# ============================================================
#  /opt/n8n/.env  -  copy to .env, fill in, then `docker compose up -d`
#  chmod 600 .env   and   NEVER commit the real .env to git
# ============================================================

# --- 1. the key that makes credentials recoverable ---
# Generate once:   openssl rand -hex 32
# Store this value in your password manager too. If it is lost, every stored
# credential becomes permanently unreadable - no reset, no support ticket.
N8N_ENCRYPTION_KEY=paste_64_hex_chars_here

# --- 2. database ---
DB_USER=n8n
DB_PASSWORD=generate_another_random_one
DB_NAME=n8n

# --- 3. your domain (webhooks must be reachable from outside) ---
N8N_HOST=n8n.example.com
TZ=UTC

# --- 4. SMTP for n8n's own error emails (optional but recommended) ---
# N8N_SMTP_HOST=
# N8N_SMTP_USER=
# N8N_SMTP_PASSWORD=
# N8N_SMTP_SENDER=
# N8N_ERROR_NOTIFICATION_RECIPIENT=

# --- 5. SSO/basic auth in front (if you don't use a proxy with auth) ---
# N8N_BASIC_AUTH_ACTIVE=true
# N8N_BASIC_AUTH_USER=
# N8N_BASIC_AUTH_PASSWORD=
